# Supabase Configuration
# Obtain from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Configuration (India Payment Gateway)
# Obtain from https://dashboard.razorpay.com/#/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret

# Optional External AI API (e.g. OpenAI or Gemini)
# If left empty, the application uses its built-in rule-based Smart Fallback Recommendation Engine seamlessly!
AI_API_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
